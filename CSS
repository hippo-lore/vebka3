* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Poppins", sans-serif;
}

body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Header */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
}

.logo {
  font-weight: 700;
  font-size: 20px;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

nav a {
  text-decoration: none;
  color: black;
  font-weight: 500;
}

nav a.active {
  font-weight: 700;
}

nav button {
  border: none;
  cursor: pointer;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 4px;
}

.sign-in {
  border: 1px solid #5a8dff;
  background-color: white;
  color: #5a8dff;
}

.sign-up {
  background-color: #5a8dff;
  color: white;
}

/* Main section */
main {
  display: flex;
  flex: 1;
  position: relative;
}

/* Left block */
.left {
  flex: 1;
  background-color: #ff6b81;
  padding: 100px 60px;
  color: black;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.left h1 {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 20px;
}

.left p {
  line-height: 1.6;
  font-size: 15px;
  margin-bottom: 30px;
}

.buttons {
  display: flex;
  gap: 20px;
  margin-bottom: 40px;
}

.btn-primary {
  background-color: #5a8dff;
  border: none;
  color: white;
  padding: 14px 32px;
  border-radius: 4px;
  font-weight: 600;
}

.btn-outline {
  border: 1.5px solid #5a8dff;
  color: #5a8dff;
  background-color: white;
  padding: 14px 32px;
  border-radius: 4px;
  font-weight: 600;
}

.socials {
  display: flex;
  align-items: center;
  gap: 15px;
}

.circle {
  width: 45px;
  height: 45px;
  background-color: #f2f2f2;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 700;
}

/* Right block */
.right {
  flex: 1;
  background-color: white;
  position: relative;
}

.illustration {
  position: absolute;
  width: 559px;
  height: 420px;
  left: 925px;
  top: 222px;
}
